---
import { withBase } from '../utils/paths';

const currentYear = new Date().getFullYear();
const homeUrl = withBase('/');
const privacyUrl = withBase('/privacy');
const blogUrl = withBase('/blog');
const iconUrl = withBase('/assets/icon.png');
---

<footer class="border-t border-slate-800/80 bg-night-950 py-12 text-slate-400">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="space-y-2">
        <div class="flex items-center gap-2.5">
          <img src={iconUrl} alt="Not This Time icon" width="24" height="24" class="h-6 w-6 rounded-lg object-cover" />
          <span class="text-base font-bold text-white">Not This Time</span>
          <span class="text-xs text-slate-500 font-medium">/ 我忍住啦</span>
        </div>
        <p class="text-sm text-slate-400 max-w-md">
          A calm, privacy-first 3-minute urge surfing timer for iOS. Ride out cravings before they turn into regrets.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-6 text-sm">
        <a href={homeUrl} class="text-slate-300 transition hover:text-white">Home</a>
        <a href={blogUrl} class="text-slate-300 transition hover:text-white">Blog</a>
        <a href="https://apps.apple.com/app/apple-store/id6769012887?pt=128462891&ct=official_website&mt=8" target="_blank" rel="noopener noreferrer" class="text-slate-300 transition hover:text-white">App Store</a>
        <a href={privacyUrl} class="text-slate-300 transition hover:text-white">Privacy Policy</a>
        <a href="mailto:zhuziwu8@gmail.com" class="text-slate-300 transition hover:text-white">Contact</a>
      </div>
    </div>

    <div class="mt-8 border-t border-slate-800/50 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} Not This Time. All rights reserved. Self-support tool, not a medical device.</p>
      <p>Zero tracking · No account required · Offline ready</p>
    </div>
  </div>
</footer>
