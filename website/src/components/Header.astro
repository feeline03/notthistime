---
import { withBase } from '../utils/paths';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const homeUrl = withBase('/');
const blogUrl = withBase('/blog');
const scienceUrl = isHome ? '#science' : `${homeUrl}#science`;
const howUrl = isHome ? '#how' : `${homeUrl}#how`;
const faqUrl = isHome ? '#faq' : `${homeUrl}#faq`;
const iconUrl = withBase('/assets/icon.png');
---

<header class="sticky top-0 z-50 border-b border-blue-500/10 bg-night-950/80 backdrop-blur-xl transition-all">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={homeUrl} class="group inline-flex items-center gap-3 text-white transition">
      <span class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-xl border border-blue-400/40 bg-gradient-to-br from-blue-500/20 to-blue-600/10 shadow-sm transition group-hover:border-blue-400/80">
        <img src={iconUrl} alt="Not This Time logo" width="36" height="36" class="h-full w-full object-cover" />
      </span>
      <span class="text-base font-bold tracking-tight text-white transition group-hover:text-blue-300">
        Not This Time
      </span>
    </a>

    <nav class="flex items-center gap-5 sm:gap-7" aria-label="Main Navigation">
      <a href={scienceUrl} class="hidden text-sm font-medium text-slate-300 transition hover:text-white md:inline-block">Science</a>
      <a href={howUrl} class="hidden text-sm font-medium text-slate-300 transition hover:text-white md:inline-block">How it works</a>
      <a href={faqUrl} class="hidden text-sm font-medium text-slate-300 transition hover:text-white md:inline-block">FAQ</a>
      <a href={blogUrl} class="text-sm font-medium text-slate-300 transition hover:text-white">Blog</a>

      <a
        href="https://apps.apple.com/app/6769012887"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-blue-500 to-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-lg shadow-blue-500/25 transition duration-200 hover:-translate-y-0.5 hover:from-blue-400 hover:to-blue-500 hover:shadow-blue-500/40 sm:px-5 sm:py-2.5 sm:text-sm"
      >
        Download App
      </a>
    </nav>
  </div>
</header>
