---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCtaBanner from '../../components/AppCtaBanner.astro';
import { withBase } from '../../utils/paths';

// Fetch published blog posts (excluding drafts and future-dated posts), sorted by date descending
const now = new Date();
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://feeline03.github.io';
const blogListUrl = new URL(withBase('/blog'), siteUrl).toString();

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Not This Time Blog - Behavioral Science & Mindful Eating",
  "url": blogListUrl,
  "description": "Evidence-based articles on urge surfing, behavioral pauses, overcoming late-night snacking, and mindful impulse control.",
};
---

<BaseLayout
  title="Blog & Science Guides | Not This Time"
  description="Practical, evidence-backed guides on urge surfing, overcoming late-night binge cravings, dopamine management, and behavioral pauses."
  schema={blogSchema}
>
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-400/30 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-300 mb-4">
        Evidence & Insights
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        The Mindful Pause Blog
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Scientific frameworks, behavioral psychology, and actionable protocols to conquer cravings and build sustainable calm.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="mt-12 space-y-8">
      {posts.map((post) => {
        const postUrl = withBase(`/blog/${post.slug}`);
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });

        return (
          <article class="group relative rounded-2xl border border-slate-800 bg-night-900/60 p-6 sm:p-8 transition-all hover:border-blue-500/40 hover:bg-night-900/90 hover:shadow-xl hover:shadow-blue-500/5">
            <div class="flex flex-wrap items-center gap-3 text-xs mb-3">
              <span class="rounded-full border border-blue-400/20 bg-blue-500/10 px-2.5 py-0.5 font-medium text-blue-300">
                {post.data.category}
              </span>
              <span class="text-slate-500">·</span>
              <span class="text-slate-400">{post.data.readingTime}</span>
              <span class="text-slate-500">·</span>
              <time datetime={post.data.pubDate.toISOString()} class="text-slate-400">
                {formattedDate}
              </time>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-white transition group-hover:text-blue-300">
              <a href={postUrl} class="focus:outline-none">
                <span class="absolute inset-0" aria-hidden="true" />
                {post.data.title}
              </a>
            </h2>

            <p class="mt-3 text-sm sm:text-base text-slate-300 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>

            <div class="mt-6 flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs text-slate-400">
                <span>By {post.data.author}</span>
              </div>
              <span class="text-xs font-semibold text-blue-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Read article →
              </span>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Conversion CTA at bottom of blog index -->
    <div class="mt-16">
      <AppCtaBanner
        title="Ready to Put Urge Surfing into Practice?"
        description="Experience the science of the 3-minute pause directly on your iPhone. Free, private, and distraction-free."
      />
    </div>
  </div>
</BaseLayout>
