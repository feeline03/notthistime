---
import BaseLayout from './BaseLayout.astro';
import AppCtaBanner from '../components/AppCtaBanner.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  readingTime: string;
  image?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  readingTime,
  image = "/assets/icon.png",
  tags = [],
  slug,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://feeline03.github.io';
const postUrl = new URL(withBase(`/blog/${slug}`), siteUrl).toString();
const homeUrl = withBase('/');
const blogUrl = withBase('/blog');

// Format date
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Not This Time",
    "logo": {
      "@type": "ImageObject",
      "url": new URL(withBase('/assets/icon.png'), siteUrl).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  }
};
---

<BaseLayout
  title={`${title} | Not This Time Blog`}
  description={description}
  image={image}
  article={true}
  publishedTime={pubDate.toISOString()}
  schema={articleSchema}
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumbs navigation -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs text-slate-400">
      <a href={homeUrl} class="transition hover:text-white">Home</a>
      <span>/</span>
      <a href={blogUrl} class="transition hover:text-white">Blog</a>
      <span>/</span>
      <span class="text-blue-400 truncate max-w-xs">{title}</span>
    </nav>

    <!-- Semantic Article Container -->
    <article class="relative">
      <header class="mb-12 border-b border-slate-800/80 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
          <span class="rounded-full border border-blue-400/30 bg-blue-500/10 px-3 py-1 font-semibold text-blue-300">
            {category}
          </span>
          <span class="text-slate-400">·</span>
          <span class="text-slate-400">{readingTime}</span>
          <span class="text-slate-400">·</span>
          <time datetime={pubDate.toISOString()} class="text-slate-400">{formattedDate}</time>
        </div>

        <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl md:text-5xl leading-[1.18]">
          {title}
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          {description}
        </p>

        <div class="mt-6 flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-600/30 text-xs font-bold text-blue-300 border border-blue-500/30">
            NT
          </div>
          <div>
            <div class="text-xs font-medium text-white">{author}</div>
            <div class="text-[11px] text-slate-400">Evidence-Based Behavioral Support</div>
          </div>
        </div>
      </header>

      <!-- Main Prose Content -->
      <div class="article-content prose prose-invert prose-blue prose-lg max-w-none">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="mt-14 flex flex-wrap items-center gap-2 border-t border-slate-800/80 pt-6">
          <span class="text-xs font-semibold text-slate-400 mr-2">Tags:</span>
          {tags.map((tag) => (
            <span class="rounded-lg border border-slate-800 bg-night-900 px-2.5 py-1 text-xs text-slate-300">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- High-Conversion Bottom CTA Banner -->
      <div class="mt-14">
        <AppCtaBanner
          title="Tired of Fighting Late-Night Cravings with Raw Willpower?"
          description="Willpower depletes as night falls. Let Not This Time act as your 3-minute physical pause and audio anchor—giving your prefrontal cortex time to regain control."
        />
      </div>

      <!-- Back to blog navigation -->
      <div class="mt-10 text-center">
        <a
          href={blogUrl}
          class="inline-flex items-center gap-2 text-sm font-medium text-blue-400 transition hover:text-blue-300"
        >
          ← Back to all articles
        </a>
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  /* Editorial-Grade Typography Styles for Blog Content */
  .article-content {
    color: #cbd5e1;
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .article-content p {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .article-content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    padding-bottom: 0.6rem;
  }

  .article-content h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #93c5fd;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    line-height: 1.35;
  }

  .article-content strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-content em {
    color: #e2e8f0;
    font-style: italic;
  }

  .article-content ul {
    list-style-type: disc;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
    padding-left: 1.6rem;
  }

  .article-content ol {
    list-style-type: decimal;
    margin-top: 1rem;
    margin-bottom: 1.75rem;
    padding-left: 1.6rem;
  }

  .article-content li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.75;
    padding-left: 0.25rem;
  }

  .article-content blockquote {
    border-left: 4px solid #3b82f6;
    background: linear-gradient(90deg, rgba(59, 130, 246, 0.12) 0%, rgba(59, 130, 246, 0.02) 100%);
    padding: 1rem 1.5rem;
    border-radius: 0 0.85rem 0.85rem 0;
    margin: 2rem 0;
    color: #e2e8f0;
    font-style: italic;
  }

  .article-content blockquote p {
    margin-bottom: 0;
  }

  .article-content hr {
    border: 0;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
    margin: 3rem 0;
  }

  .article-content a {
    color: #60a5fa;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .article-content a:hover {
    color: #93c5fd;
  }
</style>
