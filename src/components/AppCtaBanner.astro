---
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  compact?: boolean;
}

const {
  title = "Tired of Fighting Late-Night Cravings with Raw Willpower?",
  description = "Willpower drains by midnight. Not This Time gives your brain a 3-minute psychological buffer through rhythmic ticking and urge surfing so the craving wave crests and passes safely.",
  compact = false,
} = Astro.props;

const timerScreenshot = withBase('/assets/screenshot-timer.png');
const appStoreUrl = "https://apps.apple.com/app/6769012887";
---

<section class:list={[
  "relative overflow-hidden rounded-3xl border border-blue-500/20 bg-gradient-to-br from-blue-950/60 via-night-900/90 to-night-950 p-6 sm:p-10 shadow-2xl backdrop-blur-sm",
  compact ? "my-8" : "my-16"
]}>
  <!-- Background glow effects -->
  <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-blue-500/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-indigo-500/15 blur-3xl"></div>

  <div class:list={[
    "relative z-10 flex flex-col items-center gap-8 md:justify-between",
    compact ? "md:flex-col text-center" : "md:flex-row text-left"
  ]}>
    <div class:list={["max-w-xl", compact ? "mx-auto" : ""]}>
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-400/30 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-300 mb-4">
        <span class="flex h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
        3-Minute Behavioral Intervention
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
        {title}
      </h3>
      <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-500/30 transition hover:-translate-y-0.5 hover:from-blue-400 hover:to-blue-500 hover:shadow-blue-500/50"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.84c.64-.78 1.08-1.86.96-2.95-1 .04-2.15.67-2.82 1.45-.58.68-1.1 1.77-.96 2.84 1.11.09 2.19-.57 2.82-1.34z"/>
          </svg>
          Download on the App Store
        </a>
        <span class="text-xs text-slate-400 font-medium">Free 3-minute timer · 100% Offline & Private</span>
      </div>
    </div>

    {!compact && (
      <div class="relative shrink-0 flex justify-center">
        <div class="w-48 sm:w-56 rounded-3xl border border-blue-400/30 bg-night-900/80 p-2.5 shadow-2xl shadow-blue-500/10 rotate-1 transition hover:rotate-0">
          <img
            src={timerScreenshot}
            alt="Not This Time timer interface"
            class="rounded-2xl object-cover"
            loading="lazy"
            width="224"
            height="480"
          />
        </div>
      </div>
    )}
  </div>
</section>
